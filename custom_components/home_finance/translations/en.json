{
  "config": {
    "step": {
      "user": {
        "title": "Connect to home-finance",
        "description": "Enter the address of your home-finance server (version 1.26.0 or newer) and an integration token created under Settings > Integrations. Only grant the scopes you want visible in Home Assistant.",
        "data": {
          "url": "Base URL",
          "api_token": "Integration token"
        },
        "data_description": {
          "url": "For example {example_url}. A pasted /api/integrations/v1 suffix is removed.",
          "api_token": "The hf_... token, shown once when it was created."
        }
      },
      "reauth_confirm": {
        "title": "Token rejected",
        "description": "The token for {url} was rejected. Tokens always expire (at most after 2 years) and can be revoked. Create a new token with the same scopes and enter it here.",
        "data": {
          "api_token": "Integration token"
        },
        "data_description": {
          "api_token": "The hf_... token, shown once when it was created."
        }
      },
      "reconfigure": {
        "title": "Reconfigure home-finance",
        "description": "Change the server address or the token.",
        "data": {
          "url": "Base URL",
          "api_token": "Integration token"
        },
        "data_description": {
          "url": "For example {example_url}. A pasted /api/integrations/v1 suffix is removed.",
          "api_token": "The hf_... token, shown once when it was created."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the server (timeout, DNS or TLS error).",
      "invalid_auth": "The token was rejected (unknown, revoked or expired).",
      "no_scopes": "The token has none of the scopes kids:read, pots:read, periods:read or years:read.",
      "unsupported_api": "The server speaks an unsupported Integration API version.",
      "invalid_url": "Enter an address that starts with http or https.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This server is already configured.",
      "reauth_successful": "The token was updated.",
      "reconfigure_successful": "The configuration was updated."
    }
  },
